{
  "name": "eodhd",
  "version": "1.0.0",
  "description": "Official TypeScript client for the EODHD financial data APIs – historical prices, fundamentals, options, news, and 70+ endpoints",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./apis": {
      "types": "./dist/apis/index.d.ts",
      "import": "./dist/apis/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "eodhd",
    "eodhistoricaldata",
    "market-data",
    "stock-market",
    "financial-data",
    "historical-prices",
    "fundamentals",
    "real-time",
    "options",
    "dividends",
    "news",
    "sentiment",
    "technical-indicators",
    "typescript",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Enlavan/EODHD-typescript-library"
  },
  "homepage": "https://eodhd.com",
  "author": "Enlavan",
  "license": "MIT"
}
